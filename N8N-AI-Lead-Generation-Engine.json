      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const lead = $('Loop Over Leads').item.json;\nlet raw = String($json.text || '').replace(/```json|```/g, '').trim();\nlet out = null;\ntry { out = JSON.parse(raw); } catch (e) { out = null; }\nconst ok = !!(out && out.subject && out.body && String(out.body).length > 20);\nreturn { json: { ...lead, ok, new_subject: ok ? out.subject : '', body: ok ? out.body : '' } };"
      },
