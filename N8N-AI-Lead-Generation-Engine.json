    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const today = new Date().toISOString().slice(0, 10);\nconst rows = items.map(i => i.json).filter(r => r.email);\nconst on = (v) => String(v || '').slice(0, 10) === today;\nconst count = (fn) => rows.filter(fn).length;\nconst added = count(r => on(r.added_at));\nconst qualified = count(r => on(r.added_at) && r.status !== 'disqualified');\nconst sent = count(r => on(r.sent_at));\nconst replies = count(r => on(r.replied_at));\nconst interested = count(r => on(r.replied_at) && ['interested', 'question'].includes(r.status));\nconst contacted = count(r => parseInt(r.step || '0', 10) >= 1);\nconst repliedTotal = count(r => r.replied_at);\nconst rate = contacted ? ((repliedTotal / contacted) * 100).toFixed(1) : '0.0';\nconst tierA = count(r => r.tier === 'A' && r.status === 'new');\nconst report = ':bar_chart: *Daily Lead Gen Report (' + today + ')*\\n'\n  + 'New leads sourced: ' + added + ' (qualified: ' + qualified + ')\\n'\n  + 'Emails sent today: ' + sent + '\\n'\n  + 'Replies today: ' + replies + ' (hot: ' + interested + ')\\n'\n  + 'Overall reply rate: ' + rate + '%\\n'\n  + 'Tier A leads waiting in queue: ' + tierA + '\\n'\n  + 'Total leads in database: ' + rows.length;\nreturn [{ json: { report } }];"
      },
