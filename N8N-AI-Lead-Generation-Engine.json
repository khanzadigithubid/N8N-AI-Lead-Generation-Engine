    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const cfg = $('Collect Existing').first().json;\nconst people = $input.first().json.people || [];\nconst seen = new Set(cfg.existing_ids);\nconst out = [];\nfor (const p of people) {\n  if (!p.id || seen.has(String(p.id))) continue;\n  if (p.has_email === false) continue;\n  seen.add(String(p.id));\n  out.push({ json: {\n    apollo_id: String(p.id),\n    first_name: p.first_name || '',\n    title: p.title || '',\n    company: (p.organization && p.organization.name) || ''\n  } });\n  if (out.length >= cfg.daily_target) break;\n}\nreturn out;"
      },
