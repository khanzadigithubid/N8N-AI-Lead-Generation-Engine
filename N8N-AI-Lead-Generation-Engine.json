        "jsCode": "const lead = $('Merge Enrichment').item.json;\nconst text = String($json.data || '')\n  .replace(/<script[\\s\\S]*?<\\/script>/gi, ' ')\n  .replace(/<style[\\s\\S]*?<\\/style>/gi, ' ')\n  .replace(/<[^>]+>/g, ' ')\n  .replace(/&nbsp;/g, ' ')\n  .replace(/\\s+/g, ' ')\n  .trim()\n  .slice(0, 3000);\nreturn { json: { ...lead, websiteText: text || 'No website content available.' } };"
