      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const base = $('Filter New People').item.json;\nconst p = $json.person || {};\nconst org = p.organization || {};\nconst email = String(p.email || '').toLowerCase();\nconst domain = org.primary_domain || '';\nreturn { json: {\n  ...base,\n  first_name: p.first_name || base.first_name,\n  name: p.name || [p.first_name, p.last_name].filter(Boolean).join(' '),\n  email,\n  email_status: p.email_status || 'unknown',\n  title: p.title || base.title,\n  company: org.name || base.company,\n  website: org.website_url || (domain ? 'https://' + domain : ''),\n  linkedin_url: p.linkedin_url || '',\n  industry: org.industry || '',\n  employees: org.estimated_num_employees || '',\n  country: p.country || ''\n} };"
      },
