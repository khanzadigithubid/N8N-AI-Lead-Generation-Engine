        "jsCode": "const lead = $('Find Lead by Thread').item.json;\nconst trig = $('Gmail Trigger (Replies)').item.json;\nlet raw = String($json.text || '').replace(/```json|```/g, '').trim();\nlet out = { category: 'question', summary: 'Could not classify automatically. Please review.' };\ntry { const p = JSON.parse(raw); if (p && p.category) out = p; } catch (e) {}\nconst replyText = String(trig.text || trig.snippet || '').slice(0, 1500);\nreturn { json: { ...lead, category: out.category, summary: out.summary, replyText, reply_message_id: trig.id } };"
