    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const DAILY_CAP = 25;   // max emails per day\nconst GAP_1 = 3;        // days before follow-up 1\nconst GAP_2 = 4;        // days after follow-up 1 before the break-up email\nconst DAY = 86400000;\nconst now = Date.now();\nconst due = [];\nfor (const it of items) {\n  const l = it.json;\n  if (!l.email) continue;\n  const step = parseInt(l.step || '0', 10);\n  const status = String(l.status || '');\n  const sent = l.sent_at ? new Date(l.sent_at).getTime() : 0;\n  let next = 0;\n  if (status === 'new' && step === 0) next = 1;\n  else if (status === 'contacted' && step === 1 && sent && now - sent >= GAP_1 * DAY) next = 2;\n  else if (status === 'contacted' && step === 2 && sent && now - sent >= GAP_2 * DAY) next = 3;\n  if (next) due.push({ json: { ...l, next_step: next } });\n}\n// follow-ups first, then new leads by AI score\ndue.sort((a, b) => (b.json.next_step > 1) - (a.json.next_step > 1) || Number(b.json.score || 0) - Number(a.json.score || 0));\nreturn due.slice(0, DAILY_CAP);"
      },
      "id": "c3d4e5f6-0019-4000-8000-000000000019",
      "name": "Select Due Leads",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
