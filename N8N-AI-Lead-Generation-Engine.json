      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.next_step == 1 ? 'TASK: Write the FIRST cold email. Max 90 words. Open with the personalization hook if one is given, connect it to the pain point, suggest ONE automation we could build, and end with one low-pressure question.' : $json.next_step == 2 ? 'TASK: Write a SHORT follow-up (max 50 words) to an email sent a few days ago. Do not repeat the intro. Add one small new idea or example of value. End with a simple question.' : 'TASK: Write a polite BREAK-UP email (max 40 words). Say this is the last note, that you will not follow up again, and that they can reach out any time.' }}\n\nLEAD:\nName: {{ $json.first_name }}\nTitle: {{ $json.title }}\nCompany: {{ $json.company }}\nPain point: {{ $json.pain_point }}\nPersonalization hook: {{ $json.personalization_hook }}",
        "messages": {
          "messageValues": [
            {
              "message": "You are a B2B outreach specialist writing on behalf of YOUR_NAME at YOUR_COMPANY. YOUR_COMPANY builds custom AI automations (customer support agents, lead generation, document processing) that save teams hours of manual work.\n\nRULES:\n1. Plain text only: no markdown, no emojis, no exclamation marks.\n2. Use ONLY facts provided in the lead data. Never invent facts, statistics, results or client names.\n3. Sound like a real person writing one-to-one, not a template. No hype words.\n4. Sign off with: YOUR_NAME, YOUR_COMPANY\n5. The very last line must be exactly: If this isn't relevant, just reply \"no\" and I won't email again.\n6. Output ONLY valid JSON: {\"subject\":\"...\",\"body\":\"...\"}. Subject: under 7 words, no clickbait."
            }
          ]
        }
      },
      "id": "c3d4e5f6-0021-4000-8000-000000000021",
      "name": "AI: Write Email",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.5,
