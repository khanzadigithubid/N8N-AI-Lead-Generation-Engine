    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const lead = $('Merge Website').item.json;\nconst minScore = $('ICP Config').first().json.min_score;\nlet raw = String($json.text || '').replace(/```json|```/g, '').trim();\nlet s = { score: 0, tier: 'C', reason: 'Could not score', pain_point: '', hook: '' };\ntry { const p = JSON.parse(raw); if (p && typeof p.score !== 'undefined') s = p; } catch (e) {}\nconst emailValid = lead.email && lead.email.includes('@') && !lead.email.includes('not_unlocked') && lead.email_status === 'verified';\nconst qualified = emailValid && Number(s.score) >= minScore;\nreturn { json: { ...lead, score: Number(s.score) || 0, tier: s.tier || 'C', score_reason: s.reason || '', pain_point: s.pain_point || '', personalization_hook: s.hook || '', status: qualified ? 'new' : 'disqualified', step: 0, added_at: new Date().toISOString() } };"
      },
